#!/usr/bin/env bash
# 誤答例: --config だけ値の確認を書き、--output には書いていません。
# さらにループの後の必須チェックが無いため、引数なしでも終了0になります。
set -Eeuo pipefail

source "${LAB_COMMON:?LAB_COMMON が未設定です}"

usage() {
  printf '%s\n' 'Usage: argparse2.sh --config FILE --output FILE [--execute]'
}

config_path=''
output_path=''
execute=false
while (($#)); do
  case "$1" in
    --config) [[ $# -ge 2 ]] || die '--config に値が必要です'; config_path=$2; shift 2 ;;
    --output) output_path=$2; shift 2 ;;
    --execute) execute=true; shift ;;
    -h|--help) usage; exit "$EXIT_OK" ;;
    *) die "不明な引数です: $1" ;;
  esac
done

printf 'config=%s output=%s execute=%s\n' "$config_path" "$output_path" "$execute"

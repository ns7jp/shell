#!/usr/bin/env bash
# 誤答例: --execute を読み捨てて execute=true を決め打ちで出します。
# ドライラン（--execute なし）でも execute=true になるため不合格です。
set -Eeuo pipefail

source "${LAB_COMMON:?LAB_COMMON が未設定です}"

usage() { printf '%s\n' 'Usage: argparse2.sh --config FILE --output FILE [--execute]'; }

config_path=''
output_path=''
while (($#)); do
  case "$1" in
    --config) [[ $# -ge 2 ]] || die '--config に値が必要です'; config_path=$2; shift 2 ;;
    --output) [[ $# -ge 2 ]] || die '--output に値が必要です'; output_path=$2; shift 2 ;;
    --execute) shift ;;
    -h|--help) usage; exit "$EXIT_OK" ;;
    *) die "不明な引数です: $1" ;;
  esac
done
[[ -n $config_path ]] || die '--config は必須です'
printf 'config=%s output=%s execute=true\n' "$config_path" "$output_path"

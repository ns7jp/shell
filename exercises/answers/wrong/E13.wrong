#!/usr/bin/env bash
# 誤答例: tar が終了0を返したことだけを信じ、成果物を読み直していません。
set -Eeuo pipefail

source "${LAB_COMMON:?LAB_COMMON が未設定です}"

src=''
dst=''
while (($#)); do
  case "$1" in
    --src) [[ $# -ge 2 ]] || die '--src に値が必要です'; src=$2; shift 2 ;;
    --dst) [[ $# -ge 2 ]] || die '--dst に値が必要です'; dst=$2; shift 2 ;;
    -h|--help) exit "$EXIT_OK" ;;
    *) die "不明な引数です: $1" ;;
  esac
done
[[ -n $src ]] || die '--src は必須です'
[[ -n $dst ]] || die '--dst は必須です'
require_absolute_safe_path SRC "$src"
require_absolute_safe_path DST "$dst"
[[ -d $src && -r $src ]] || die "アーカイブ元を読み取れません: $src"
require_command tar

archive="$dst/$(basename -- "$src").tar.gz"
log INFO "アーカイブ元: $src"
log INFO "保存先: $archive"
mkdir -p -- "$dst"
tar -C "$(dirname -- "$src")" -czf "$archive" -- "$(basename -- "$src")"

# ここが誤りです。作っただけで、ある・中身を確かめていません。
log OK "アーカイブを作成しました: $archive"

#!/usr/bin/env bash
# @LAB_ID@ @LAB_TITLE@
# 穴は1つだけです。共通ライブラリの関数を1行呼びます。
set -Eeuo pipefail

source "${LAB_COMMON:?LAB_COMMON が未設定です。source \"$HOME/bash-lab/labenv.sh\" を実行してください}"

# --- 受ける ----------------------------------------------------------------
# 環境変数 PORT を受け取ります。未設定でも set -u で落ちないように受けます。
PORT=${PORT:-}
[[ -n $PORT ]] || die 'PORT は必須です'

# --- 疑う（ここが穴です） --------------------------------------------------
# 整数かどうかと、1 から 65535 の範囲かどうかを、共通ライブラリの関数1行で確かめます。
# 判定を自分で書いてはいけません（同じ判定が2箇所にあると、必ずずれます）。
# TODO: ここに1行だけ書きます

# --- 伝える ----------------------------------------------------------------
log OK "PORT=$PORT は使えます"
